PORT=8000
NODE_ENV=DEVELOPMENT

MONGO_URI=mongodb+srv://youruser:yourpass@cluster0.mongodb.net/yourdbname?retryWrites=true&w=majority

FRONT_URL=http://localhost:5173

JWT_SECRET=your_jwt_secret_key_change_this_to_long_random_string
JWT_EXPIRE=7d

ACTIVATION_SECRET=your_activation_secret_key_change_this_to_another_random_string

CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_API_KEY=pk_test_your_stripe_publishable_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_smtp_password
